              "value": "data_processed"
            },
            {
              "name": "content",
              "value": "={{ 'Processed ' + $json.rules_applied + ' rules for data processing' }}"
            },
            {
              "name": "metadata",
              "value": "={{ { \"timestamp\": $json.timestamp, \"result\": $json.processed } }}"
            }
          ]
        },
