      "id": "get-context",
      "name": "Get UMC Context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "// Process data using context from UMC\nconst inputData = $input.first().json;\nconst context = $('Get UMC Context').first().json;\n\n// Extract processing rules from context\nconst rules = context.context_blocks || [];\nconst processingRules = rules\n  .filter(block => block.event_type === 'processing_rule')\n  .map(block => block.content);\n\n// Apply rules to input data\nlet processedData = { ...inputData };\n\nfor (const rule of processingRules) {\n  // Example: Apply transformation rules\n  // This is where you'd implement your business logic\n  console.log('Applying rule:', rule);\n}\n\nreturn {\n  json: {\n    original: inputData,\n    processed: processedData,\n    rules_applied: processingRules.length,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "process-with-context",
      "name": "Process with Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
