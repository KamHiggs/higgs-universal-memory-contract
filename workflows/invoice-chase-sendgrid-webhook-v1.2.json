        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "sendgrid-events"
    },
    {
      "parameters": {
        "content": "## SendGrid Event Webhook Handler\n\n**Purpose:** Process deliverability events from SendGrid\n\n**Events handled:**\n- bounce (permanent failure)\n- dropped (previously bounced)\n- spamreport (customer marked as spam)\n- unsubscribe (customer unsubscribed)\n\n**Actions:**\n- Update suppression_list\n- Log to audit_events\n- Create human_task for important customers\n\n**Setup:**\n1. In SendGrid: Settings → Mail Settings → Event Webhook\n2. Set URL: https://your-n8n.com/webhook/sendgrid-events\n3. Select events: bounce, dropped, spam report, unsubscribe\n4. Save\n\n**Security:**\nTODO: Add webhook signature validation",
        "height": 500,
        "width": 600
      },
      "id": "sticky-readme",
      "name": "README",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-200, 180]
    },
    {
      "parameters": {
        "jsCode": "// Parse SendGrid event array\nconst body = $input.item.json.body;\nconst events = Array.isArray(body) ? body : [body];\n\nconsole.log(`Received ${events.length} SendGrid events`);\n\nreturn events.map(event => ({ json: event }));"
      },
      "id": "code-parse",
      "name": "Parse Events Array",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// Process deliverability event\nconst event = $input.item.json;\n\nconst eventType = event.event; // bounce, dropped, spamreport, unsubscribe\nconst email = event.email;\nconst timestamp = new Date(event.timestamp * 1000).toISOString();\n\n// Determine suppression action\nlet emailSuppressed = false;\nlet reason = null;\n\nswitch (eventType) {\n  case 'bounce':\n    if (event.type === 'blocked' || event.status && event.status.startsWith('5')) {\n      emailSuppressed = true;\n      reason = `bounce_${event.type}_${event.reason}`;\n    }\n    break;\n  case 'dropped':\n    emailSuppressed = true;\n    reason = `dropped_${event.reason}`;\n    break;\n  case 'spamreport':\n    emailSuppressed = true;\n    reason = 'spam_report';\n    break;\n  case 'unsubscribe':\n    emailSuppressed = true;\n    reason = 'unsubscribe_sendgrid';\n    break;\n}\n\nreturn {\n  event_type: eventType,\n  email: email,\n  timestamp: timestamp,\n  email_suppressed: emailSuppressed,\n  reason: reason,\n  raw_event: event\n};"
      },
      "id": "code-process",
      "name": "Process Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.email_suppressed}}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-suppress",
      "name": "Should Suppress?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO suppression_list (tenant_id, email, email_suppressed, reason, updated_at)\nVALUES ('default', $1, true, $2, NOW())\nON CONFLICT (tenant_id, email) \nDO UPDATE SET \n  email_suppressed = true,\n  reason = EXCLUDED.reason,\n  updated_at = NOW()\nRETURNING id;",
        "additionalFields": {
          "queryParameters": "={{ [$json.email, $json.reason] }}"
        }
      },
      "id": "postgres-suppress",
      "name": "Update Suppression List",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [1120, 200],
      "credentials": {
        "postgres": {
          "id": "postgres-main",
          "name": "PostgreSQL Account"
        }
      }
    },
    {
