      "parameters": {
        "jsCode": "// Create promise to pay record\nconst item = $input.item.json;\n\n// TODO: Parse promise_date properly\nconst promiseDate = item.promise_date || new Date(Date.now() + 7*24*60*60*1000).toISOString().split('T')[0]; // Default: 7 days\n\nreturn {\n  tenant_id: 'default',\n  invoice_id: 'UNKNOWN', // TODO: Map sender to invoice\n  customer_id: 'UNKNOWN',\n  promise_date: promiseDate,\n  note: `Customer promised via ${item.source}: ${item.message_body}`\n};"
      },
