      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO suppression_list (tenant_id, email, phone, email_suppressed, sms_suppressed, reason, updated_at)\nVALUES ('default', $1, $2, $3, $4, 'customer_stop_request', NOW())\nON CONFLICT (tenant_id, COALESCE(email, phone))\nDO UPDATE SET\n  email_suppressed = CASE WHEN $3 THEN true ELSE suppression_list.email_suppressed END,\n  sms_suppressed = CASE WHEN $4 THEN true ELSE suppression_list.sms_suppressed END,\n  reason = 'customer_stop_request',\n  updated_at = NOW();",
        "additionalFields": {
          "queryParameters": "={{ [\n  $json.source === 'email' ? $json.sender : null,\n  $json.source === 'sms' ? $json.sender : null,\n  $json.source === 'email',\n  $json.source === 'sms'\n] }}"
        }
