# Higgs Universal Memory Contract - Environment Configuration

# Database Configuration
DATABASE_URL=postgresql://umc_user:umc_password_change_me@localhost:5432/umc_memory
POSTGRES_DB=umc_memory
POSTGRES_USER=umc_user
POSTGRES_PASSWORD=umc_password_change_me

# UMC Server Configuration
UMC_HOST=0.0.0.0
UMC_PORT=8000
LOG_LEVEL=info
ENVIRONMENT=development

# n8n Configuration (if running n8n separately)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_please
N8N_HOST=0.0.0.0
N8N_PORT=5678

# Genesis Void Configuration
GENESIS_EXPLORATION_BUDGET_PCT=20
GENESIS_DISCOVERY_SCHEDULE=daily
GENESIS_PROMOTION_MIN_SAMPLES=100
GENESIS_FITNESS_IMPROVEMENT_THRESHOLD=1.10

# Optional: External Services
# OPENAI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here
